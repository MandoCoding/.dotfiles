{
   "$schema": "https://vicinae.com/schemas/config.json",
   "font": {
      "normal": {
         "family": "SF Pro Display"
      }
   },
   "theme": {
      "dark": {
         "name": "vicinae-dark",
         "icon_theme": "WhiteSur-dark"
      }
   },
   "launcher_window": {
      "opacity": 0.5,
      "client_side_decorations": {
         "border_width": 2
      }
   },
   "favorites": [
      "files:search",
      "clipboard:history"
   ],
   "providers": {
      "@abielzulio/store.raycast.chatgpt": {
         "enabled": false,
         "preferences": {
            "isAutoFullInput": false,
            "isAutoLoadText": false,
            "isAutoSaveConversation": true,
            "isAutoTTS": false,
            "isCustomModel": false,
            "isHistoryPaused": false,
            "proxyProtocol": "http",
            "useApiEndpoint": false,
            "useAzure": false,
            "useProxy": false,
            "useStream": true,
            "useVisionModel": false
         },
         "entrypoints": {
            "ask-clipboard-image": {
               "enabled": false
            },
            "ask-selected-image": {
               "enabled": false
            },
            "create-ai-command": {
               "enabled": false
            },
            "model": {
               "enabled": false
            },
            "search-ai-command": {
               "enabled": false
            },
            "summarize": {
               "enabled": false
            }
         }
      },
      "@mmstroik/store.vicinae.kde-system-settings": {
         "enabled": false
      },
      "@sovereign/store.vicinae.awww-switcher": {
