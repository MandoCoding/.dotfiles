{
   "$schema": "https://vicinae.com/schemas/config.json",
   "font": {
      "normal": {
         "family": "SF Pro Display"
      }
   },
   "theme": {
      "dark": {
         "name": "vicinae-dark",
         "icon_theme": "WhiteSur-dark"
      }
   },
   "launcher_window": {
      "opacity": 0.5,
      "client_side_decorations": {
         "border_width": 2
      }
   },
   "favorites": [
      "files:search",
      "clipboard:history"
   ],
   "providers": {
      "@abielzulio/store.raycast.chatgpt": {
         "enabled": false,
         "preferences": {
            "isAutoFullInput": false,
            "isAutoLoadText": false,
            "isAutoSaveConversation": true,
            "isAutoTTS": false,
            "isCustomModel": false,
            "isHistoryPaused": false,
            "proxyProtocol": "http",
            "useApiEndpoint": false,
            "useAzure": false,
            "useProxy": false,
            "useStream": true,
            "useVisionModel": false
         },
         "entrypoints": {
            "ask-clipboard-image": {
               "enabled": false
            },
            "ask-selected-image": {
               "enabled": false
            },
            "create-ai-command": {
               "enabled": false
            },
            "model": {
               "enabled": false
            },
            "search-ai-command": {
               "enabled": false
            },
            "summarize": {
               "enabled": false
            }
         }
      },
      "@mmstroik/store.vicinae.kde-system-settings": {
         "enabled": false
      },
      "@sovereign/store.vicinae.awww-switcher": {
         "preferences": {
            "wallpaperPath": "/home/mando/Pictures/Wallpaper",
            "colorGenTool": "none",
            "gridRows": "4",
            "postProduction": "no",
            "showImageDetails": true,
            "toggleVicinaeSetting": true,
            "transitionDuration": "3",
            "transitionFPS": "60",
            "transitionStep": "90",
            "transitionType": "random"
         }
      },
      "@system7/store.vicinae.keepassxc": {
         "preferences": {
            "database": "/home/mando/Documents/software/KeePassXC/Browser-FF.kdbx"
         }
      },
      "@tonka3000/store.raycast.speedtest": {
         "enabled": false
      },
      "core": {
         "entrypoints": {
            "about": {
               "enabled": true
            },
            "documentation": {
               "enabled": false
            },
            "forget-telemetry": {
               "enabled": false
            },
            "manage-fallback": {
               "enabled": false
            },
            "oauth-token-store": {
               "enabled": false
            },
            "open-config-file": {
               "enabled": false
            },
            "open-default-config": {
               "enabled": false
            },
            "prune-memory": {
               "enabled": false
            },
            "reload-scripts": {
               "enabled": false
            },
            "report-bug": {
               "enabled": false
            },
            "search-builtin-icons": {
               "enabled": false
            },
            "search-emojis": {
               "enabled": false
            },
            "sponsor": {
               "enabled": false
            }
         }
      },
      "developer": {
         "enabled": false
      },
      "font": {
         "enabled": true
      },
      "power": {
         "enabled": true,
         "entrypoints": {
            "hibernate": {
               "enabled": false
            },
            "soft-reboot": {
               "enabled": false
            },
            "suspend": {
               "enabled": false
            }
         }
      },
      "system": {
         "entrypoints": {
            "browse-apps": {
               "enabled": true
            },
            "toggle-mute": {
               "enabled": false
            },
            "volume-0": {
               "enabled": false
            },
            "volume-100": {
               "enabled": false
            },
            "volume-25": {
               "enabled": false
            },
            "volume-50": {
               "enabled": false
            },
            "volume-75": {
               "enabled": false
            },
            "volume-down": {
               "enabled": false
            },
            "volume-up": {
               "enabled": false
            }
         }
      },
      "theme": {
         "enabled": false,
         "entrypoints": {
            "set": {
               "enabled": true
            }
         }
      },
      "wm": {
         "enabled": false
      }
   }
}